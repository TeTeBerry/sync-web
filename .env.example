# Server-side activity reads (defaults to production CloudBase API when unset)
API_BASE_URL=https://sync-backend-prd-269371-9-1442514260.sh.run.tcloudbase.com/api
# Optional: point API_BASE_URL at a local backend instead, e.g. http://127.0.0.1:3000/api
# Raven origin fuzzy search (GET /api/raven/place-suggestions) requires the Nest backend
# on that base URL — run `pnpm run start:dev` in sync-app-backend (or `pnpm run dev:all`).
# sync-web `pnpm run dev` proxies browser calls from /api/raven/* → API_BASE_URL/raven/*.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# Local override, or use POSTGRES_URL from Vercel Supabase integration
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# POSTGRES_URL is injected automatically when Supabase is connected on Vercel

# Temporary Raven email-only auth (MVP). Production must set explicitly to true.
TEMP_EMAIL_ONLY_AUTH_ENABLED=true
NEXT_PUBLIC_TEMP_EMAIL_ONLY_AUTH_ENABLED=true
# Auth persistence: set DATABASE_URL/POSTGRES_URL for real sessions.
# Without it, local/dev automatically uses an in-memory store (resets on restart).
# AUTH_MEMORY_FALLBACK=true
# Optional unverified-session limits
# TEMP_AUTH_MAX_CONNECTION_REQUESTS_PER_DAY=5
# TEMP_AUTH_MAX_PRIVATE_PROFILE_VIEWS_PER_HOUR=20
# TEMP_AUTH_LOGIN_IP_MAX=20
# TEMP_AUTH_LOGIN_EMAIL_MAX=10
# NEXT_PUBLIC_TEMP_AUTH_MAX_CONNECTION_REQUESTS_PER_DAY=5
# NEXT_PUBLIC_TEMP_AUTH_MAX_PRIVATE_PROFILE_VIEWS_PER_HOUR=20
