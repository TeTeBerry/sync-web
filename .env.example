# Server-side activity reads (defaults to production CloudBase API when unset)
API_BASE_URL=https://sync-backend-prd-269371-9-1442514260.sh.run.tcloudbase.com/api
# Optional: point API_BASE_URL at a local backend instead, e.g. http://127.0.0.1:3000/api
# Raven origin fuzzy search (GET /api/raven/place-suggestions) requires the Nest backend
# on that base URL — run `pnpm run start:dev` in sync-app-backend (or `pnpm run dev:all`).
# sync-web `pnpm run dev` proxies browser calls from /api/raven/* → API_BASE_URL/raven/*.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# Auth.js uses the same MongoDB cluster as Nest but isolated raven_auth_* collections.
MONGODB_URI=mongodb://127.0.0.1:27017/sync
# Generate with: openssl rand -base64 32. Never expose this value to the browser.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
# Optional endpoint overrides for deployments whose network cannot reach oauth2.googleapis.com.
# AUTH_GOOGLE_TOKEN_URL=https://www.googleapis.com/oauth2/v4/token
# AUTH_GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo
# Shared only between the Next server and Nest server; required for trusted /internal auth exchange.
INTERNAL_API_KEY=replace-with-a-long-random-secret
